# ============================================================
# ARCHI — Bitrix24 (box) & GitHub კონფიგურაცია
# დააკოპირე ეს ფაილი როგორც .env და შეავსე რეალური მნიშვნელობებით.
# .env გიტში არ იტვირთება (.gitignore).
# ============================================================

# --- Bitrix24 პორტალი ---
# მაგ: https://crm.archi.ge  (ბოლოში / გარეშე)
BITRIX_URL=

# --- Inbound Webhook-ები (Developer resources -> Other -> Inbound webhook) ---
# ფორმატი: https://<portal>/rest/<user_id>/<code>/
# თითოეულს თავისი წვდომები (scopes) — შეავსე რაც გაქვს, დანარჩენი ცარიელი დატოვე.
BITRIX_WEBHOOK_CRM=
BITRIX_WEBHOOK_TASKS=
BITRIX_WEBHOOK_BIZPROC=
BITRIX_WEBHOOK_USER=
BITRIX_WEBHOOK_DISK=
# ზოგადი / დამატებითი webhook (თუ ერთი გაქვს ყველა წვდომით)
BITRIX_WEBHOOK_DEFAULT=

# --- იუზერის მონაცემები (მხოლოდ თუ webhook-ით ვერ ხერხდება) ---
BITRIX_USER_LOGIN=
BITRIX_USER_PASSWORD=

# --- GitHub ---
# Fine-grained Personal Access Token, მხოლოდ refreshg/archi_workflows რეპოზე
# წვდომები: Contents: Read and write, Metadata: Read
GITHUB_REPO=https://github.com/refreshg/archi_workflows.git
GITHUB_USER=refreshg
GITHUB_TOKEN=
